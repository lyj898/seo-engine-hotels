---
// Stylised constellation map of Southeast Asia for the home hero
// (2026-10-29 Members' Lounge redesign). Not geographically exact -- a
// decorative field of brass dots, with the larger hubs labelled. Colour
// comes from currentColor; labels and grid use the muted/divider tokens.
const { class: className = '' } = Astro.props;
const dots = [
  [150,70,3],[170,62,2.5],[188,78,2.5],[176,96,2.5],[148,134,2.5],[196,110,2.5],[226,96,2.5],[232,130,2.5],
  [222,152,3],[152,168,2.5],[142,156,3],[162,196,2.5],[132,214,2.5],[118,236,2.5],[214,290,2.5],[262,306,2.5],
  [316,318,2.5],[276,236,2.5],[300,222,2.5],[318,246,2.5],[356,250,2.5],[336,96,2.5],[360,146,2.5],[372,176,2.5],
  [384,200,2.5],[356,186,2.5],
];
const hubs = [
  { x: 214, y: 66, label: 'Hanoi', lx: 226, ly: 62 },
  { x: 160, y: 118, label: 'Bangkok', lx: 92, ly: 114 },
  { x: 172, y: 218, label: 'Kuala Lumpur', lx: 70, ly: 222 },
  { x: 186, y: 240, label: 'Singapore', lx: 198, ly: 248 },
  { x: 232, y: 300, label: 'Jakarta', lx: 200, ly: 330 },
  { x: 296, y: 314, label: 'Bali', lx: 306, ly: 340 },
  { x: 346, y: 116, label: 'Manila', lx: 358, ly: 112 },
];
const pulses = [[186, 240, '0s'], [296, 314, '1.1s'], [160, 118, '2.2s']];
---

<svg viewBox="0 0 520 380" class={className} role="img" aria-label="Stylised map of Southeast Asia showing the cities covered">
  <g class="stroke-brand-divider dark:stroke-brand-divider-dark" stroke-width="1" fill="none">
    <path d="M60 40h400M60 120h400M60 200h400M60 280h400M140 20v340M260 20v340M380 20v340" />
  </g>
  <g fill="currentColor">
    {dots.map(([x, y, r]) => <circle cx={x} cy={y} r={r} opacity="0.5" />)}
    {hubs.map((h) => <circle cx={h.x} cy={h.y} r="4.5" />)}
  </g>
  <g fill="none" stroke="currentColor">
    {pulses.map(([x, y, d]) => <circle class="sea-pulse" cx={x} cy={y} r="4" style={`animation-delay:${d}`} />)}
  </g>
  <g class="fill-brand-muted dark:fill-brand-muted-dark" font-size="11" font-weight="600" letter-spacing="1.3">
    {hubs.map((h) => <text x={h.lx} y={h.ly}>{h.label.toUpperCase()}</text>)}
  </g>
</svg>

<style>
  .sea-pulse { opacity: 0.6; animation: sea-pulse 3.2s ease-out infinite; }
  @keyframes sea-pulse { 0% { r: 4; opacity: 0.7; } 100% { r: 16; opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .sea-pulse { animation: none; display: none; } }
</style>
