---
// Client-side filter chips over already-rendered, already-crawlable cards
// (it hides/shows, never removes from the DOM, so search/AI crawlers still
// see every entity regardless of JS). Pairs with EntityCard's
// data-filterable/data-tags attributes.
//
// options: [{ label, value }] -- value should match a tag that appears in
// the rendered cards' data-tags. Persists the user's last choice to
// localStorage when site.config.json.enabledFeatures.savedFilters is on
// (checked by the page including this component, not here, so this stays
// a dumb reusable component).
//
// maxVisible caps how many option chips render before a "+N more" toggle
// chip takes over -- a long, unsorted-looking chip wall (e.g. 30+ cities on
// a loyalty-program page where almost every city has a hotel) reads as
// broken even though the filtering itself works; capping it mirrors the
// homepage's own "show top N, link to the full list" pattern rather than
// dumping every option on screen at once. Callers should pass options
// already sorted the way they want the visible ones ranked (e.g. by count
// descending) -- this component only decides how many to show, not the
// order.
const { options = [], targetSelector = '[data-filterable]', storageKey = 'filter', maxVisible = null } = Astro.props;
const visibleOptions = maxVisible ? options.slice(0, maxVisible) : options;
const overflowOptions = maxVisible ? options.slice(maxVisible) : [];
---

{options.length > 0 && (
  <div
    class="filter-bar mb-6 inline-flex flex-wrap gap-0.5 rounded-full bg-brand-surface-offset p-[3px] dark:bg-brand-surface-offset-dark"
    data-target={targetSelector}
    data-storage-key={storageKey}
  >
    <button type="button" data-filter-value="" class="filter-chip is-active rounded-full px-3.5 py-2 text-sm font-semibold text-brand-muted transition-colors dark:text-brand-muted-dark">
      All
    </button>
    {visibleOptions.map((opt) => (
      <button
        type="button"
        data-filter-value={opt.value}
        class="filter-chip rounded-full px-3.5 py-2 text-sm font-semibold text-brand-muted transition-colors dark:text-brand-muted-dark"
      >
        {opt.label}
      </button>
    ))}
    {overflowOptions.length > 0 && (
      <button type="button" class="filter-chip-toggle rounded-full px-3.5 py-2 text-sm font-semibold text-brand-muted underline-offset-2 transition-colors hover:underline dark:text-brand-muted-dark">
        +{overflowOptions.length} more
      </button>
    )}
    {overflowOptions.map((opt) => (
      <button
        type="button"
        data-filter-value={opt.value}
        class="filter-chip filter-chip-overflow hidden rounded-full px-3.5 py-2 text-sm font-semibold text-brand-muted transition-colors dark:text-brand-muted-dark"
      >
        {opt.label}
      </button>
    ))}
  </div>
)}

<script is:inline>
  (function () {
    document.querySelectorAll('.filter-bar').forEach(function (bar) {
      var targetSelector = bar.dataset.target;
      var storageKey = bar.dataset.storageKey;
      var chips = bar.querySelectorAll('.filter-chip');

      function applyFilter(value) {
        document.querySelectorAll(targetSelector).forEach(function (el) {
          var tags = (el.dataset.tags || '').split(',');
          el.style.display = !value || tags.indexOf(value) !== -1 ? '' : 'none';
        });
        chips.forEach(function (chip) {
          chip.classList.toggle('is-active', chip.dataset.filterValue === value);
        });
        try {
          localStorage.setItem(storageKey, value);
        } catch (e) {
          /* ignore */
        }
      }

      chips.forEach(function (chip) {
        chip.addEventListener('click', function () {
          applyFilter(chip.dataset.filterValue);
        });
      });

      var overflowToggle = bar.querySelector('.filter-chip-toggle');
      if (overflowToggle) {
        overflowToggle.addEventListener('click', function () {
          bar.querySelectorAll('.filter-chip-overflow').forEach(function (chip) {
            chip.classList.remove('hidden');
          });
          overflowToggle.remove();
        });
      }

      var saved = '';
      try {
        saved = localStorage.getItem(storageKey) || '';
      } catch (e) {
        /* ignore */
      }
      if (saved) {
        // If the restored value belongs to a chip that starts hidden in the
        // overflow section, reveal the whole section -- otherwise the chip
        // would be silently active but invisible, and the toggle would still
        // claim there are "+N more" chips including the one already applied.
        var savedChip = bar.querySelector('.filter-chip-overflow[data-filter-value="' + saved + '"]');
        if (savedChip && overflowToggle) overflowToggle.click();
        applyFilter(saved);
      }
    });
  })();
</script>
