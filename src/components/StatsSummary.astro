---
// stats: [{ label, value }] -- hub-page "summary stats" requirement.
// Values are computed by the page (Step 4) from the actual data set, never
// hardcoded, so they can't drift out of sync with what's really listed.
//
// 2026-08-03 editorial redesign: a hairline-bordered, centered row replaces
// the original bordered-box grid -- consistent with the rest of the
// redesign's "hairlines instead of boxed cards" rule.
const { stats = [] } = Astro.props;
---

{stats.length > 0 && (
  <dl class="grid grid-cols-2 gap-8 border-y border-brand-divider py-8 dark:border-brand-divider-dark sm:grid-cols-4 sm:divide-x sm:divide-brand-divider sm:dark:divide-brand-divider-dark">
    {stats.map((s) => (
      <div class="text-center">
        <dd class="font-serif text-2xl font-normal sm:text-3xl">{s.value}</dd>
        <dt class="kicker mt-1 text-brand-faint dark:text-brand-faint-dark">{s.label}</dt>
      </div>
    ))}
  </dl>
)}
