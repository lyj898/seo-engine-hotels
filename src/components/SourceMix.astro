---
// "How we researched this" -- an E-E-A-T transparency block that surfaces the
// source_mix every entity carries (official pages + review aggregators the
// research stage actually consulted), plus when each was last checked and how
// recently the page's research was refreshed. Replaces the old (never-
// populated) excerpt_quotes "What people say" section, which needed a field
// no entity has. This is a curated LINK-OUT list, never reproduced content --
// same posture as ExternalCoverage.
const { sources = [], lastUpdated } = Astro.props;
const hasContent = sources.length > 0;

function formatDate(iso) {
  if (!iso) return '';
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return '';
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}

// source type -> human label. Unknown types fall back to the raw value so a
// new source category still renders something sensible.
const TYPE_LABEL = { official: 'Official', review: 'Guest reviews', editorial: 'Editorial', news: 'News' };
function typeLabel(t) {
  return TYPE_LABEL[t] ?? (t ? t.charAt(0).toUpperCase() + t.slice(1) : 'Source');
}

function hostname(url) {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return '';
  }
}
---

{hasContent && (
  <section>
    <p class="kicker text-brand-primary dark:text-brand-primary-hover-dark">Behind this page</p>
    <h2 class="mt-2 font-serif text-xl font-normal sm:text-2xl">How we researched this</h2>
    <p class="mt-2 max-w-2xl text-sm text-brand-muted dark:text-brand-muted-dark">
      This page pulls from the hotel&rsquo;s own information alongside independent guest reviews. These are the primary
      sources we checked{lastUpdated ? <> &mdash; last refreshed {formatDate(lastUpdated)}</> : ''}.
    </p>

    <ul class="mt-5 divide-y divide-brand-divider border-t border-brand-divider dark:divide-brand-divider-dark dark:border-brand-divider-dark">
      {sources.map((s) => (
        <li>
          <a href={s.url} target="_blank" rel="noopener noreferrer nofollow" class="group flex items-start justify-between gap-4 py-4">
            <div class="min-w-0">
              <p class="text-sm font-medium group-hover:text-brand-primary dark:group-hover:text-brand-primary-hover-dark">
                {s.label}
              </p>
              <p class="kicker mt-1 text-brand-faint dark:text-brand-faint-dark">
                {typeLabel(s.type)}{hostname(s.url) ? ` · ${hostname(s.url)}` : ''}{s.last_checked ? ` · checked ${formatDate(s.last_checked)}` : ''}
              </p>
            </div>
            <span class="kicker mt-0.5 shrink-0 text-brand-faint dark:text-brand-faint-dark">&#8599;</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
