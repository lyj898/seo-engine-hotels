---
import siteConfig from '../lib/config.js';
import { urls } from '../lib/urls.js';
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-brand-divider dark:border-brand-divider-dark">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 text-sm sm:grid-cols-3 sm:px-6">
    <div>
      <p class="font-serif text-lg">{siteConfig.siteName}</p>
      <p class="mt-2 italic text-brand-muted dark:text-brand-muted-dark">{siteConfig.siteTagline}</p>
    </div>
    <div>
      <p class="kicker text-brand-faint dark:text-brand-faint-dark">Explore</p>
      <ul class="mt-3 space-y-2">
        <li><a href={urls.categoriesIndex()} class="text-brand-muted transition-colors hover:text-brand-primary dark:text-brand-muted-dark dark:hover:text-brand-primary-hover-dark">Categories</a></li>
        <li><a href={urls.regionsIndex()} class="text-brand-muted transition-colors hover:text-brand-primary dark:text-brand-muted-dark dark:hover:text-brand-primary-hover-dark">Regions</a></li>
        {siteConfig.enabledFeatures?.listicles && (
          <li><a href={urls.listiclesIndex()} class="text-brand-muted transition-colors hover:text-brand-primary dark:text-brand-muted-dark dark:hover:text-brand-primary-hover-dark">Best Of guides</a></li>
        )}
      </ul>
    </div>
    <div>
      <p class="kicker text-brand-faint dark:text-brand-faint-dark">About</p>
      <ul class="mt-3 space-y-2">
        <li><a href={urls.about()} class="text-brand-muted transition-colors hover:text-brand-primary dark:text-brand-muted-dark dark:hover:text-brand-primary-hover-dark">About &amp; Methodology</a></li>
        <li><a href={urls.privacy()} class="text-brand-muted transition-colors hover:text-brand-primary dark:text-brand-muted-dark dark:hover:text-brand-primary-hover-dark">Privacy</a></li>
        <li><a href={urls.terms()} class="text-brand-muted transition-colors hover:text-brand-primary dark:text-brand-muted-dark dark:hover:text-brand-primary-hover-dark">Terms</a></li>
        <li><a href={urls.contact()} class="text-brand-muted transition-colors hover:text-brand-primary dark:text-brand-muted-dark dark:hover:text-brand-primary-hover-dark">Contact</a></li>
      </ul>
    </div>
  </div>
  <div class="kicker border-t border-brand-divider py-5 text-center text-brand-faint dark:border-brand-divider-dark dark:text-brand-faint-dark">
    © {year} {siteConfig.siteName} -- see our
    <a href={urls.about()} class="hover:text-brand-primary dark:hover:text-brand-primary-hover-dark">methodology</a>
  </div>
</footer>
