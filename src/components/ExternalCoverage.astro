---
// 2026-08-03: "Verified elsewhere" section on the entity detail page --
// links out to real, independently published reviews and YouTube videos
// about this specific entity, found on the open web and curated for
// recency (~last 1-2 years) and credibility (reach/subscriber count).
//
// This is deliberately a curated LINK-OUT list, not reproduced content:
// each review shows only our own short paraphrase (never the source's own
// wording at length) plus a link back to the original, and each video uses
// YouTube's own embed (via video_id) rather than any rehosted copy -- both
// standard, uncontroversial practice (a "press" or "as seen in" roundup),
// and the reason this stays simple attribution rather than a copyright
// concern.
//
// Video embeds use a click-to-load facade (thumbnail + play button) rather
// than an always-on iframe, so a page with several videos doesn't pull in
// YouTube's full player JS (and its tracking) for a visitor who never
// presses play.
const { reviews = [], videos = [] } = Astro.props;
const hasContent = reviews.length > 0 || videos.length > 0;

function formatDate(iso) {
  if (!iso) return '';
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return '';
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
}

function formatViews(n) {
  if (typeof n !== 'number') return '';
  if (n >= 1000) return `${(n / 1000).toFixed(n % 1000 === 0 ? 0 : 1)}k views`;
  return `${n} views`;
}
---

{hasContent && (
  <section>
    <p class="kicker text-brand-primary dark:text-brand-primary-hover-dark">Verified elsewhere</p>
    <h2 class="mt-2 font-serif text-xl font-normal sm:text-2xl">Reviews &amp; videos from around the web</h2>
    <p class="mt-2 max-w-2xl text-sm text-brand-muted dark:text-brand-muted-dark">
      Independent coverage from real reviewers and travel channels, published in the last year or two -- not written or
      commissioned by us. Each links back to the original.
    </p>

    {reviews.length > 0 && (
      <div class="mt-8">
        <p class="kicker text-brand-faint dark:text-brand-faint-dark">Written reviews</p>
        <div class="mt-3 divide-y divide-brand-divider border-t border-brand-divider dark:divide-brand-divider-dark dark:border-brand-divider-dark">
          {reviews.map((review) => (
            <a href={review.url} target="_blank" rel="noopener noreferrer nofollow" class="group block py-5">
              <div class="flex items-start justify-between gap-4">
                <h3 class="font-serif text-lg font-normal group-hover:text-brand-primary dark:group-hover:text-brand-primary-hover-dark">
                  {review.title}
                </h3>
                <span class="kicker mt-1 shrink-0 text-brand-faint dark:text-brand-faint-dark">&#8599;</span>
              </div>
              <p class="kicker mt-1 text-brand-faint dark:text-brand-faint-dark">
                {review.source}{review.author ? ` · ${review.author}` : ''}{review.published_date ? ` · ${formatDate(review.published_date)}` : ''}
              </p>
              {review.summary && (
                <p class="mt-2 max-w-2xl text-sm leading-relaxed text-brand-muted dark:text-brand-muted-dark">{review.summary}</p>
              )}
            </a>
          ))}
        </div>
      </div>
    )}

    {videos.length > 0 && (
      <div class="mt-10">
        <p class="kicker text-brand-faint dark:text-brand-faint-dark">Video reviews</p>
        <div class="mt-3 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-2">
          {videos.map((video) => (
            <div>
              <div
                class="yt-facade group relative flex aspect-video cursor-pointer items-center justify-center overflow-hidden bg-brand-panel-a dark:bg-brand-panel-a-dark"
                data-video-id={video.video_id}
                data-video-title={video.title}
                role="button"
                tabindex="0"
                aria-label={`Play video: ${video.title}`}
              >
                <img
                  src={`https://i.ytimg.com/vi/${video.video_id}/hqdefault.jpg`}
                  alt=""
                  loading="lazy"
                  class="h-full w-full object-cover opacity-90 transition-opacity group-hover:opacity-100"
                />
                <span class="pointer-events-none absolute flex h-14 w-14 items-center justify-center rounded-full bg-black/55 text-white backdrop-blur-sm transition-transform group-hover:scale-110">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
                </span>
              </div>
              <h3 class="mt-3 text-base font-normal leading-snug">
                <a
                  href={video.url}
                  target="_blank"
                  rel="noopener noreferrer nofollow"
                  class="hover:text-brand-primary dark:hover:text-brand-primary-hover-dark"
                >
                  {video.title}
                </a>
              </h3>
              <p class="kicker mt-1 text-brand-faint dark:text-brand-faint-dark">
                {video.channel}{video.view_count ? ` · ${formatViews(video.view_count)}` : ''}{video.published_date ? ` · ${formatDate(video.published_date)}` : ''}
              </p>
            </div>
          ))}
        </div>
      </div>
    )}
  </section>
)}

<script is:inline>
  (function () {
    document.querySelectorAll('.yt-facade').forEach(function (facade) {
      function play() {
        var id = facade.dataset.videoId;
        var title = facade.dataset.videoTitle || 'YouTube video';
        var iframe = document.createElement('iframe');
        iframe.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1';
        iframe.title = title;
        iframe.className = 'h-full w-full';
        iframe.frameBorder = '0';
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;
        facade.replaceChildren(iframe);
        facade.classList.remove('cursor-pointer');
      }
      facade.addEventListener('click', play);
      facade.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          play();
        }
      });
    });
  })();
</script>
