---
// faqs: [{ question, answer }]. Native <details>/<summary> -- content is
// in the DOM regardless of open/closed state, so it's fully crawlable with
// zero JS. Step 6 adds a buildFaqPageSchema(faqs) helper that consumes this
// SAME array to emit FAQPage JSON-LD, so a page never defines its FAQs twice.
const { faqs = [], heading = 'Frequently asked questions' } = Astro.props;
---

{faqs.length > 0 && (
  <section aria-labelledby="faq-heading">
    <h2 id="faq-heading" class="mb-4 font-serif text-xl font-normal sm:text-2xl">{heading}</h2>
    <div class="divide-y divide-brand-divider border-t border-brand-divider dark:divide-brand-divider-dark dark:border-brand-divider-dark">
      {faqs.map((faq) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-serif text-lg font-normal">
            <span>{faq.question}</span>
            <span
              aria-hidden="true"
              class="shrink-0 text-brand-primary transition-transform group-open:rotate-45 dark:text-brand-primary-hover-dark"
            >
              +
            </span>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-brand-muted dark:text-brand-muted-dark">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>
)}
