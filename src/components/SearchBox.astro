---
// Free-text client-side search, matching the reference design's hero
// search box exactly (rounded input, left icon, focus ring). Filters by
// hiding/showing -- never removing from the DOM -- the same way FilterBar
// does, so crawlers still see every card regardless of JS.
//
// v1 scope note: this targets one section per page (e.g. the home page's
// "Highest-verified" grid). Don't combine it with FilterBar targeting the
// SAME elements on the same page -- both scripts independently set
// `style.display`, and whichever runs last on a given interaction wins,
// so a combined search+filter UI needs a merged script, not these two
// components side by side.
const { targetSelector = '[data-filterable]', placeholder = 'Search...' } = Astro.props;
---

<!--
  2026-08-03 editorial redesign: a hairline-underlined inline field replaces
  the original rounded, shadowed pill input -- matching the mockup's plain
  "icon + text, one bottom rule" search treatment.
-->
<div
  class="search-box group mx-auto flex max-w-sm items-center gap-2 border-b border-brand-divider pb-2 focus-within:border-brand-text dark:border-brand-divider-dark dark:focus-within:border-brand-text-dark"
  data-target={targetSelector}
>
  <svg
    class="h-4 w-4 shrink-0 text-brand-faint dark:text-brand-faint-dark"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    <circle cx="11" cy="11" r="7" />
    <path d="m21 21-4.35-4.35" />
  </svg>
  <input
    type="text"
    class="search-input w-full border-none bg-transparent p-0 text-sm placeholder:text-brand-faint focus:outline-none focus:ring-0 dark:placeholder:text-brand-faint-dark"
    placeholder={placeholder}
    aria-label={placeholder}
  />
</div>

<script is:inline>
  (function () {
    document.querySelectorAll('.search-box').forEach(function (box) {
      var input = box.querySelector('.search-input');
      var targetSelector = box.dataset.target;
      if (!input) return;
      input.addEventListener('input', function () {
        var q = input.value.trim().toLowerCase();
        document.querySelectorAll(targetSelector).forEach(function (el) {
          var haystack = el.dataset.search || '';
          el.style.display = !q || haystack.indexOf(q) !== -1 ? '' : 'none';
        });
      });
    });
  })();
</script>
