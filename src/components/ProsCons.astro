---
// pros/cons arrive pre-escaped HTML strings (see autolink.js's
// createEntityLinker, the only caller) so a mention of another hotel by
// name can render as a real link -- rendered via set:html rather than
// Astro's default text interpolation for that reason.
const { pros = [], cons = [] } = Astro.props;
---

{(pros.length > 0 || cons.length > 0) && (
  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
    {pros.length > 0 && (
      <div>
        <h3 class="mb-2 text-sm font-semibold text-brand-success dark:text-brand-success-dark">Pros</h3>
        <ul class="space-y-2 text-sm">
          {pros.map((p) => (
            <li class="flex gap-2">
              <span aria-hidden="true" class="text-brand-success dark:text-brand-success-dark">+</span>
              <span set:html={p} />
            </li>
          ))}
        </ul>
      </div>
    )}
    {cons.length > 0 && (
      <div>
        <h3 class="mb-2 text-sm font-semibold text-brand-error dark:text-brand-error-dark">Cons</h3>
        <ul class="space-y-2 text-sm">
          {cons.map((c) => (
            <li class="flex gap-2">
              <span aria-hidden="true" class="text-brand-error dark:text-brand-error-dark">–</span>
              <span set:html={c} />
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
)}
