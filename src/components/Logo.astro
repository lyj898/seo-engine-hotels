---
// EliteStay mark (2026-10-29 Members' Lounge redesign): a brass line-art
// hotel inside a square, replacing the earlier "T" monogram left over from
// the template. Stroke/fill follow the brand gold so it reads in both
// themes; public/favicon.svg is the same drawing on a dark tile.
const { size = 26, class: className = '' } = Astro.props;
---

<svg
  viewBox="0 0 40 40"
  width={size}
  height={size}
  fill="none"
  aria-hidden="true"
  class={`text-brand-primary dark:text-brand-primary-hover-dark ${className}`}
>
  <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <rect x="1" y="1" width="38" height="38" rx="2" />
    <path d="M10 29V14l10-6 10 6v15" />
    <path d="M16 29v-7h8v7" />
    <path d="M10 29h20" />
  </g>
  <circle cx="20" cy="16" r="1.8" fill="currentColor" />
</svg>
