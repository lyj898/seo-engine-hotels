---
// EliteStay wordmark icon (2026-08-03 editorial redesign): an outlined
// square with a gold "T" monogram, matching the redesign mockup and
// public/favicon.svg's filled version. Replaces the original generic
// disc+pulse-line mark, which was a chain-agnostic placeholder copied from
// the races instance and never actually resembled either the "StayElite"
// or "EliteStay" wordmark.
//
// Dark mode reuses primary-hover-dark (see site.config.json's theme._note)
// as the readable "gold" against the dark background, matching every other
// gold accent in the redesign (kicker labels, hover states, the CTA button).
const { size = 26, class: className = '' } = Astro.props;
---

<svg viewBox="0 0 26 26" width={size} height={size} fill="none" aria-hidden="true" class={className}>
  <rect
    x="0.5"
    y="0.5"
    width="25"
    height="25"
    class="stroke-brand-primary dark:stroke-brand-primary-hover-dark"
    stroke-width="1"
  />
  <path
    d="M8.5 9V7.6h9V9h-3.55v9.5H12.5V9H8.5Z"
    class="fill-brand-primary dark:fill-brand-primary-hover-dark"
  />
</svg>
