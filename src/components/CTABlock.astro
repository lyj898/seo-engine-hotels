---
import siteConfig from '../lib/config.js';

// ctaLinks: [{ label, url, type }] -- first link is styled as primary.
// affiliateLinks only render at all if site.config.json.enabledFeatures
// .affiliateLinks is true for this vertical instance (races/local-services
// have it off; hotels/courses have it on -- see /config-examples).
const { ctaLinks = [], affiliateLinks = [], heading } = Astro.props;
const showAffiliate = Boolean(siteConfig.enabledFeatures?.affiliateLinks) && affiliateLinks.length > 0;

// Clicking out of this block is the only action a reader can take that maps
// to revenue, so it emits a GA4 event. Gated on googleAnalyticsId because
// without analytics configured the script is dead weight on every entity
// page (657 of them in the hotels instance).
const trackClicks = Boolean(siteConfig.googleAnalyticsId);
---

{(ctaLinks.length > 0 || showAffiliate) && (
  <div
    data-cta-block
    class="rounded-lg border border-brand-border bg-brand-surface p-6 dark:border-brand-border-dark dark:bg-brand-surface-dark"
  >
    {heading && <p class="mb-3 font-semibold">{heading}</p>}
    <div class="flex flex-wrap gap-3">
      {ctaLinks.map((cta, i) => (
        <a
          href={cta.url}
          rel="noopener"
          target="_blank"
          data-cta-type={cta.type ?? 'cta'}
          data-cta-label={cta.label}
          class={
            i === 0
              ? 'inline-flex items-center rounded-md bg-brand-primary px-4 py-2.5 text-sm font-bold text-brand-primary-ink transition-colors duration-200 ease-interactive hover:bg-brand-primary-hover dark:text-brand-primary-ink-dark dark:hover:bg-brand-primary-hover-dark'
              : 'inline-flex items-center rounded-md border border-brand-border px-4 py-2.5 text-sm font-medium transition-colors hover:bg-brand-surface-offset dark:border-brand-border-dark dark:hover:bg-brand-surface-offset-dark'
          }
        >
          {cta.label}
        </a>
      ))}
      {showAffiliate &&
        affiliateLinks.map((link) => (
          <a
            href={link.url}
            rel="sponsored noopener"
            target="_blank"
            data-cta-type="affiliate"
            data-cta-label={link.label}
            class="inline-flex items-center rounded-md border border-brand-border px-4 py-2.5 text-sm font-medium transition-colors hover:bg-brand-surface-offset dark:border-brand-border-dark dark:hover:bg-brand-surface-offset-dark"
          >
            {link.label}
          </a>
        ))}
    </div>
    {showAffiliate && (
      <p class="mt-3 text-xs text-brand-muted dark:text-brand-muted-dark">
        Some links above are affiliate links; we may earn a commission at no extra cost to you.
      </p>
    )}
    {trackClicks && (
      <script is:inline>
        /*
          WHY A CUSTOM EVENT AND NOT GA4's BUILT-IN OUTBOUND CLICK
          Enhanced Measurement already logs a generic `click` for outbound
          links, but it cannot say WHICH cta was clicked -- a booking link
          and an "official site" link are the same event to it. link_type
          separates them.

          WHAT THIS DOES AND DOESN'T MEASURE (checked 2026-09-09)
          NOT revenue. `monetizationModel` is "affiliate" and
          enabledFeatures.affiliateLinks is on, but `affiliate_links` is
          empty on all 657 published hotels -- WORKPLAN.md WS6 is still
          blocked on choosing an affiliate program, so nothing here earns
          yet and the "affiliate" link_type never fires. What it does
          measure is outbound INTENT: 650 official_website + 7 booking_link
          ctas. That is precisely the evidence WS6 is blocked on -- if
          nobody clicks out, wiring an affiliate program earns nothing
          whichever one is picked; if they do, this says how many and which
          hotels drive it.

          WHY HOTEL IDENTITY ISN'T A PARAMETER
          GA4 attaches page_location and page_title to every event
          automatically, so `cta_click` breaks down by page (i.e. by hotel)
          with no parameters passed in and no custom-dimension setup. That
          also keeps this component's props unchanged and vertical-agnostic
          -- it never has to know what an entity is.

          Delegated from the block rather than bound per link: one listener
          regardless of how many buttons render, and it survives markup
          changes. `is:inline` matches BaseLayout's gtag bootstrap and avoids
          adding a bundled JS request to a site that currently ships zero
          hydration islands (which is what makes it cleanly extractable to
          the AI crawlers robots.txt deliberately invites).

          Fails silent by design: gtag is absent when analytics is blocked by
          an extension or still loading, and a dead analytics call must never
          swallow the click the reader actually wanted.
        */
        document.querySelectorAll('[data-cta-block]').forEach(function (block) {
          block.addEventListener('click', function (event) {
            var target = event.target;
            if (!target || typeof target.closest !== 'function') return;
            var link = target.closest('a[data-cta-type]');
            if (!link || typeof window.gtag !== 'function') return;
            window.gtag('event', 'cta_click', {
              link_type: link.dataset.ctaType,
              link_label: link.dataset.ctaLabel || link.textContent.trim(),
              link_url: link.href,
            });
          });
        });
      </script>
    )}
  </div>
)}
