---
import siteConfig from '../lib/config.js';
import { urls } from '../lib/urls.js';
import { loadEntities, loadCategories, loadRegions, stripMeta, isPublished, buildRegionAncestryMap } from '../lib/data.js';
import { entityMatchesCategory } from '../lib/categoryMatch.js';
import { splitByParticipation } from '../lib/loyalty.js';
import { proseList } from '../lib/text.js';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQSection from '../components/FAQSection.astro';
import { buildFaqPageSchema, buildBreadcrumbListSchema } from '../lib/schema-jsonld.js';

// NOTE FOR ANYONE FORKING THIS ENGINE: unlike the hub and detail templates,
// this page's prose is deliberately vertical-SPECIFIC and has to be rewritten
// for each instance. It previously wasn't -- the hotels instance shipped the
// races instance's copy with the nouns swapped, so a hotel reader was told to
// "confirm exact dates, distances, and registration details directly with the
// race's own official page", and the page claimed "we don't score or rate
// listings against each other" while the home page and every guide ranked
// hotels by score. A trust page that contradicts the site is worse than no
// trust page, so this one states what this site actually does.
//
// This page is the site's trust page, so everything on it that can be
// computed IS computed. The coverage table below is built from the same
// loaders every hub page uses, which means it cannot drift into claiming a
// footprint the directory doesn't have -- the failure mode a hand-written
// "we cover Southeast Asia's major loyalty programs" paragraph invites.
const entities = loadEntities().map(stripMeta).filter(isPublished);
const categories = loadCategories().map(stripMeta).filter(isPublished);
const regions = loadRegions().map(stripMeta).filter(isPublished);
const ancestry = buildRegionAncestryMap(regions);
const regionsById = new Map(regions.map((r) => [r.region_id, r]));

const countryLabel = (regionId) => {
  const chain = ancestry.get(regionId) ?? [regionId];
  const countryId = chain[chain.length - 1];
  return regionsById.get(countryId)?.label ?? countryId;
};

const coverage = categories
  .map((category) => {
    const matched = entities.filter((e) => entityMatchesCategory(e, category, categories));
    const { participating, nonParticipating } = splitByParticipation(matched);
    return {
      label: category.label,
      href: urls.category(category.slug),
      count: participating.length,
      excluded: nonParticipating.length,
      countries: [...new Set(participating.map((e) => countryLabel(e.region_id)))].sort((a, b) => a.localeCompare(b)),
      cities: new Set(participating.map((e) => e.region_id)).size,
    };
  })
  .sort((a, b) => b.count - a.count);

const totalNonParticipating = splitByParticipation(entities).nonParticipating.length;

// The thinnest program, named out loud rather than left at the bottom of a
// sorted table for a reader to notice. A directory that covers one chain
// deeply and another barely is still useful -- but only if it says which is
// which before someone plans a trip around it.
const thinnest = coverage.length > 1 ? coverage[coverage.length - 1] : null;

// Loyalty programs operating in Southeast Asia that this directory does not
// track at all. Stated here because an absence is invisible on every other
// page: nothing about a site listing four programs tells a reader that a
// fifth major one is missing entirely.
const UNCOVERED_PROGRAMS = ['Hilton Honors', 'Wyndham Rewards', 'Radisson Rewards', 'Shangri-La Circle'];


const breadcrumbItems = [
  { label: siteConfig.siteName, href: urls.home() },
  { label: 'About & Methodology', href: urls.about() },
];

const faqs = [
  {
    question: `How accurate is the information on ${siteConfig.siteName}?`,
    answer:
      `Every listing is compiled and cross-checked against official sources and aggregators on a best-effort basis, ` +
      `not guaranteed. Room counts, elite benefits, restaurant and lounge openings and loyalty-program terms all ` +
      `change on the underlying source faster than a listing is re-checked, so confirm anything your booking depends ` +
      `on with the hotel or the program before you book.`,
  },
  {
    question: 'What does the guest sentiment score mean?',
    answer:
      `It is a 0-100 read of what guests report about a property, synthesized from public reviews and stay reports ` +
      `and graded against that hotel's own class. A well-run economy hotel and a landmark luxury property can both ` +
      `score in the low 90s, because their guests are grading different promises. It is not a luxury ranking and it ` +
      `is not comparable across brand tiers.`,
  },
  {
    question: 'Why is a hotel listed under a program it does not participate in?',
    answer:
      `A small number of properties carry a chain's brand name without being enrolled in that chain's loyalty ` +
      `program -- much of the Singapore and Jakarta ibis budget estate sits outside ALL, for example. The review is ` +
      `still worth having, so the hotel stays in the directory with a clear label, but it is excluded from ` +
      `program counts, editor's picks and the ranked guides.`,
  },
  {
    question: 'Does AI write the content on this site?',
    answer:
      `AI is used to summarize and organize facts that were already gathered from real sources -- it is never used to ` +
      `invent facts. Summaries, pros, cons, FAQ answers and the guest sentiment score are generated strictly from the ` +
      `structured facts and short source excerpts attached to each listing, and anything the pipeline can't validate ` +
      `is skipped rather than published.`,
  },
];

const jsonLd = [
  ...(siteConfig.enabledFeatures?.faqSchema ? [buildFaqPageSchema(faqs)] : []),
  buildBreadcrumbListSchema(breadcrumbItems, Astro.site),
].filter(Boolean);
---

<BaseLayout
  title="About & Methodology"
  description={`How ${siteConfig.siteName} researches, verifies, scores and updates every listing -- and exactly which loyalty programs it covers.`}
  canonicalPath={urls.about()}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <Breadcrumb items={breadcrumbItems} />
    <h1 class="mt-4 font-serif text-3xl font-semibold sm:text-4xl">About & Methodology</h1>

    <div class="prose-content mt-8 space-y-4">
      <p>
        {siteConfig.siteName} reviews {siteConfig.entityLabelPlural} that belong to hotel loyalty programs across
        Southeast Asia, organized by {siteConfig.categoryLabel.toLowerCase()} and {siteConfig.regionLabel.toLowerCase()}.
        Every listing is built from structured facts and short, attributed source excerpts -- never from raw copied
        content -- and every page shows the sources it was built from and the date each was last checked.
      </p>

      <h2 class="text-xl font-semibold">How we verify listings</h2>
      <p>
        Each {siteConfig.entityLabelSingular} is checked against multiple independent sources: the chain's own
        property page and booking flow, the loyalty program's terms, review aggregators, and first-hand stay
        reports where they exist. Listings are re-verified on a rolling basis, roughly every
        {' '}{siteConfig.sourceConfig?.refreshIntervalDays ?? 7} days, and every page shows the date it was last
        checked.
      </p>

      <h2 class="text-xl font-semibold">Best-effort, not guaranteed</h2>
      <p>
        This is a best-effort directory, not an authoritative source. A hotel's room count, its restaurants and
        lounge, what a given elite tier actually gets, and whether the property is in the program at all can all
        change on the source faster than a listing is re-checked. Confirm exact rates, elite benefits and program
        participation directly with the hotel or the loyalty program before making a decision that depends on them.
      </p>

      <h2 id="guest-sentiment" class="scroll-mt-24 text-xl font-semibold">What the guest sentiment score means</h2>
      <p>
        Most listings carry a <strong>guest sentiment</strong> number from 0 to 100, with a breakdown across location,
        service, rooms, food &amp; breakfast, and value. It is a synthesized read of what guests actually report about
        a property in public reviews and stay reports -- not a measurement we take ourselves, not an average of star
        ratings, and not a price or luxury grade.
      </p>
      <p>
        The important limit: <strong>it grades a hotel against its own class, so it is not comparable across brand
        tiers.</strong> A 2-star economy hotel whose guests consistently get exactly what they were promised can score
        as highly as a grande-dame landmark whose guests expect far more. Both numbers are honest; they are answers to
        different questions. Use it to compare hotels of a similar type, and read the brand tier shown next to every
        score before comparing across types. Where a hotel is too new or too thinly reviewed for the score to mean
        anything, no number is shown rather than a placeholder one.
      </p>
      <p>
        We do rank listings against each other where a page says so -- the editor's picks on the home page and every
        guide under Recommends are ordered by this score, with the ordering rule stated on the page. Nothing else on
        the site is a ranking: hub pages and search results are not ordered by quality, and inclusion in the directory
        is never influenced by commercial terms.
      </p>

      <h2 id="coverage" class="scroll-mt-24 text-xl font-semibold">What we cover -- and what we don't</h2>
      <p>
        Coverage is uneven by program, and the numbers below are generated from the live directory rather than
        written by hand, so this section cannot fall out of date with the rest of the site. It counts only hotels that
        actually participate in the program they are filed under.
      </p>
    </div>

    <div class="mt-6 overflow-x-auto">
      <table class="w-full min-w-max border-collapse text-sm">
        <caption class="sr-only">Coverage by loyalty program</caption>
        <thead>
          <tr class="border-b border-brand-border text-left dark:border-brand-border-dark">
            <th scope="col" class="py-2 pr-4 font-semibold">{siteConfig.categoryLabel}</th>
            <th scope="col" class="py-2 pr-4 text-right font-semibold capitalize">{siteConfig.entityLabelPlural}</th>
            <th scope="col" class="py-2 pr-4 text-right font-semibold">Cities</th>
            <th scope="col" class="py-2 font-semibold">Countries covered</th>
          </tr>
        </thead>
        <tbody>
          {coverage.map((row) => (
            <tr class="border-b border-brand-border last:border-0 dark:border-brand-border-dark">
              <th scope="row" class="py-2 pr-4 text-left align-top font-medium">
                <a href={row.href} class="link-accent">{row.label}</a>
              </th>
              <td class="py-2 pr-4 text-right align-top tabular-nums">{row.count}</td>
              <td class="py-2 pr-4 text-right align-top tabular-nums">{row.cities}</td>
              <td class="py-2 align-top text-brand-muted dark:text-brand-muted-dark">{row.countries.join(', ')}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="prose-content mt-6 space-y-4">
      <p>
        Read that table as the shape of the directory, not as a map of the region. It reflects where research has
        actually been done so far, which is not the same as where each chain operates.
        {thinnest && (
          <Fragment>
            {' '}{thinnest.label} in particular is thin: {thinnest.count}
            {' '}{thinnest.count === 1 ? siteConfig.entityLabelSingular : siteConfig.entityLabelPlural} in
            {' '}{thinnest.countries.length === 1 ? '1 country' : `${thinnest.countries.length} countries`}
            {' '}({thinnest.countries.join(', ')}), while the program operates in markets across the region that
            this site already covers for other chains. Treat it as a starting point rather than a shortlist.
          </Fragment>
        )}
      </p>
      <p>
        Programs we do <strong>not</strong> cover at all include {proseList(UNCOVERED_PROGRAMS)}. Their hotels are
        absent from every page here, so this directory is not a complete view of loyalty stays in Southeast Asia and
        should not be used as one. Adding a program means researching real properties one at a time, so new
        coverage arrives gradually and is visible in this table as it lands.
      </p>
      {totalNonParticipating > 0 && (
        <p>
          Separately, {totalNonParticipating} reviewed {siteConfig.entityLabelPlural} carry a chain's brand name but
          do not participate in that chain's program -- no points, no elite benefits. They are labelled on their own
          pages and everywhere they are listed, and they are excluded from the counts above, from editor's picks, and
          from the ranked guides.
        </p>
      )}

      <h2 class="text-xl font-semibold">How AI is used</h2>
      <p>
        AI-generated summaries, pros/cons, FAQ answers and the guest sentiment read are produced strictly from the
        structured facts and source excerpts already attached to a listing. The generation process is instructed to
        never introduce a fact that wasn't present in that input, and any response that fails validation is discarded
        rather than published.
      </p>
      {siteConfig.monetizationModel !== 'none' && (
        <Fragment>
          <h2 class="text-xl font-semibold">How this site makes money</h2>
          <p>
            Some listings include affiliate or referral links, clearly marked where they appear. This never affects
            which listings are included or how they are ordered -- inclusion is based solely on the verification
            process described above, and the ranked guides are ordered by guest sentiment alone.
          </p>
        </Fragment>
      )}
    </div>

    <section class="mt-14">
      <FAQSection faqs={faqs} />
    </section>
  </div>
</BaseLayout>
