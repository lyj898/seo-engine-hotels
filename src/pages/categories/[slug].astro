---
import siteConfig from '../../lib/config.js';
import { urls } from '../../lib/urls.js';
import { loadEntities, loadCategories, loadRegions, stripMeta, isPublished, buildRegionAncestryMap } from '../../lib/data.js';
import { entityMatchesCategory } from '../../lib/categoryMatch.js';
import { byUpcomingDate } from '../../lib/sort.js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import StatsSummary from '../../components/StatsSummary.astro';
import GroupedRegionFilter from '../../components/GroupedRegionFilter.astro';
import EntityCard from '../../components/EntityCard.astro';
import HubCard from '../../components/HubCard.astro';
import FAQSection from '../../components/FAQSection.astro';
import { buildItemListSchema, buildFaqPageSchema, buildBreadcrumbListSchema } from '../../lib/schema-jsonld.js';

export function getStaticPaths() {
  const categories = loadCategories().map(stripMeta);
  return categories.map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const allEntities = loadEntities().map(stripMeta).filter(isPublished);
const allCategories = loadCategories().map(stripMeta);
const allRegions = loadRegions().map(stripMeta);

const entities = allEntities
  .filter((e) => entityMatchesCategory(e, category, allCategories))
  .sort(byUpcomingDate);

const stats = [
  { label: `${siteConfig.entityLabelPlural}`, value: entities.length },
  { label: `${siteConfig.regionLabelPlural ?? `${siteConfig.regionLabel}s`} represented`, value: new Set(entities.map((e) => e.region_id)).size },
];

// Sideways links: this category's related_category_ids.
const relatedCategories = allCategories.filter((c) => category.related_category_ids?.includes(c.category_id));

// Filter: country -> city, not a flat city chip row. A loyalty programme
// like Marriott or Accor has a hotel in nearly every one of 35+ tracked
// cities, so listing every represented city at once -- even sorted, even
// capped behind a "+N more" toggle -- is a wall/lump either way. Grouping
// by country first and only revealing a country's cities once it's picked
// keeps each screenful to a handful of chips regardless of how many cities
// the category actually covers. Cities within each country and the
// countries themselves are both ranked by hotel count, so the most-covered
// country/city leads.
const ancestryMap = buildRegionAncestryMap(allRegions);
const regionsById = new Map(allRegions.map((r) => [r.region_id, r]));
const countByCity = new Map();
for (const e of entities) countByCity.set(e.region_id, (countByCity.get(e.region_id) ?? 0) + 1);

const countryGroups = new Map(); // country region_id -> { value, label, count, cities: [] }
for (const [cityId, count] of countByCity) {
  const chain = ancestryMap.get(cityId) ?? [cityId];
  const countryId = chain[chain.length - 1];
  const countryRegion = regionsById.get(countryId);
  if (!countryGroups.has(countryId)) {
    countryGroups.set(countryId, { value: countryId, label: countryRegion?.label ?? countryId, count: 0, cities: [] });
  }
  const group = countryGroups.get(countryId);
  group.count += count;
  const cityRegion = regionsById.get(cityId);
  group.cities.push({ value: cityId, label: cityRegion?.label ?? cityId, count });
}
const regionFilterGroups = [...countryGroups.values()]
  .map((g) => ({ ...g, cities: g.cities.sort((a, b) => b.count - a.count || a.label.localeCompare(b.label)) }))
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));

const breadcrumbItems = [
  { label: siteConfig.siteName, href: urls.home() },
  { label: `All ${siteConfig.categoryLabel}s`, href: urls.categoriesIndex() },
  { label: category.label, href: urls.category(category.slug) },
];

const jsonLd = [
  ...(siteConfig.enabledFeatures?.itemListSchema
    ? [buildItemListSchema(entities, Astro.site, (e) => urls.entity(e.slug), (e) => e.name)]
    : []),
  ...(siteConfig.enabledFeatures?.faqSchema ? [buildFaqPageSchema(category.faqs)] : []),
  buildBreadcrumbListSchema(breadcrumbItems, Astro.site),
].filter(Boolean);
---

<BaseLayout
  title={category.label}
  description={category.short_description}
  canonicalPath={urls.category(category.slug)}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <Breadcrumb items={breadcrumbItems} />
    <h1 class="mt-4 font-serif text-3xl font-semibold sm:text-4xl">{category.label}</h1>
    <div class="prose-content mt-4 max-w-2xl">
      <p>{category.intro ?? category.short_description}</p>
    </div>

    <div class="mt-8">
      <StatsSummary stats={stats} />
    </div>

    {entities.length > 0 ? (
      <div class="mt-10">
        {regionFilterGroups.length > 1 && (
          <GroupedRegionFilter groups={regionFilterGroups} storageKey={`filter-category-${category.slug}`} />
        )}
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {entities.map((entity) => <EntityCard entity={entity} categories={allCategories} regions={allRegions} />)}
        </div>
      </div>
    ) : (
      <p class="mt-10 text-brand-muted dark:text-brand-muted-dark">
        No {siteConfig.entityLabelPlural} published in this category yet -- check back soon.
      </p>
    )}

    {relatedCategories.length > 0 && (
      <section class="mt-14">
        <h2 class="mb-4 text-xl font-semibold">Related {siteConfig.categoryLabel.toLowerCase()}s</h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {relatedCategories.map((c) => (
            <HubCard href={urls.category(c.slug)} label={c.label} description={c.short_description} />
          ))}
        </div>
      </section>
    )}

    <section class="mt-14">
      <FAQSection faqs={category.faqs} heading={`${category.label} FAQs`} />
    </section>
  </div>
</BaseLayout>
