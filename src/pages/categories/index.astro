---
import siteConfig from '../../lib/config.js';
import { urls } from '../../lib/urls.js';
import { loadEntities, loadCategories, stripMeta, isPublished } from '../../lib/data.js';
import { entityMatchesCategory } from '../../lib/categoryMatch.js';
import { participatesInProgram } from '../../lib/loyalty.js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import HubCard from '../../components/HubCard.astro';
import { buildBreadcrumbListSchema } from '../../lib/schema-jsonld.js';

const categories = loadCategories().map(stripMeta).filter(isPublished);
const entities = loadEntities().map(stripMeta).filter(isPublished);

// Same label the header and footer nav use, so all three agree on what this
// destination is called.
const categoryLabelPlural = siteConfig.categoryLabelPlural ?? `${siteConfig.categoryLabel}s`;

const breadcrumbItems = [
  { label: siteConfig.siteName, href: urls.home() },
  { label: `All ${categoryLabelPlural}`, href: urls.categoriesIndex() },
];

const jsonLd = [buildBreadcrumbListSchema(breadcrumbItems, Astro.site)].filter(Boolean);
---

<BaseLayout
  title={`All ${categoryLabelPlural}`}
  description={`Every ${siteConfig.categoryLabel.toLowerCase()} covered by ${siteConfig.siteName}.`}
  canonicalPath={urls.categoriesIndex()}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <Breadcrumb items={breadcrumbItems} />
    <h1 class="mt-4 font-serif text-3xl font-semibold sm:text-4xl">All {categoryLabelPlural}</h1>
    <p class="mt-3 max-w-2xl text-brand-muted dark:text-brand-muted-dark">
      Browse every {siteConfig.entityLabelSingular} on {siteConfig.siteName} grouped by {siteConfig.categoryLabel.toLowerCase()}.
    </p>

    {categories.length > 0 ? (
      <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {/* Program counts, so only hotels actually in the program are
            counted -- matching the headline stat on each hub page, and for
            the same reason: the number sits next to a program's name and
            is read as a claim about that program's reach. */}
        {categories.map((category) => (
          <HubCard
            href={urls.category(category.slug)}
            label={category.label}
            description={category.short_description}
            count={entities.filter((e) => entityMatchesCategory(e, category, categories) && participatesInProgram(e)).length}
          />
        ))}
      </div>
    ) : (
      <p class="mt-8 text-brand-muted dark:text-brand-muted-dark">No categories published yet.</p>
    )}
  </div>
</BaseLayout>
