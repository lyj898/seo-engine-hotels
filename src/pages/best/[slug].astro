---
import siteConfig from '../../lib/config.js';
import { urls } from '../../lib/urls.js';
import { loadEntities, loadCategories, loadRegions, loadListicles, stripMeta, isPublished } from '../../lib/data.js';
import { resolveListicleEntities } from '../../lib/listicles.js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FAQSection from '../../components/FAQSection.astro';
import LastUpdated from '../../components/LastUpdated.astro';
import { brandPresentation, tierLabel, TIER_REGISTER } from '../../lib/brand.js';
import { buildItemListSchema, buildFaqPageSchema, buildBreadcrumbListSchema } from '../../lib/schema-jsonld.js';

export function getStaticPaths() {
  const listicles = loadListicles().map(stripMeta);
  return listicles.map((listicle) => ({
    params: { slug: listicle.slug },
    props: { listicle },
  }));
}

const { listicle } = Astro.props;
const allEntities = loadEntities().map(stripMeta).filter(isPublished);
const allCategories = loadCategories().map(stripMeta);
const allRegions = loadRegions().map(stripMeta);

const rankedEntities = resolveListicleEntities(listicle, allEntities, allRegions, allCategories);

const breadcrumbItems = [
  { label: siteConfig.siteName, href: urls.home() },
  { label: 'Recommends', href: urls.listiclesIndex() },
  { label: listicle.title, href: urls.listicle(listicle.slug) },
];

const jsonLd = [
  ...(siteConfig.enabledFeatures?.itemListSchema
    ? [buildItemListSchema(rankedEntities, Astro.site, (e) => urls.entity(e.slug), (e) => e.name)]
    : []),
  ...(siteConfig.enabledFeatures?.faqSchema ? [buildFaqPageSchema(listicle.faqs)] : []),
  buildBreadcrumbListSchema(breadcrumbItems, Astro.site),
].filter(Boolean);
---

<BaseLayout
  title={listicle.title}
  description={listicle.intro}
  canonicalPath={urls.listicle(listicle.slug)}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <Breadcrumb items={breadcrumbItems} />
    <h1 class="mt-4 font-serif text-3xl font-semibold sm:text-4xl">{listicle.title}</h1>
    <div class="mt-2">
      <LastUpdated date={listicle.last_updated} />
    </div>
    <div class="prose-content mt-4">
      <p>{listicle.intro}</p>
    </div>

    {rankedEntities.length > 0 ? (
      // Deliberately NOT EntityCard's grid-oriented brand panel here --
      // that's an aspect-[4/3] hero block sized for a multi-column grid
      // (every other place it's used: home page, region/category hub
      // pages, RelatedEntities), and crammed one-per-row into a numbered
      // list it read as an oversized, wrong-context card rather than a
      // ranked article entry. This is a bespoke compact row instead: a
      // small tier-coloured monogram tile carries the same colour signal
      // at list scale, and the hotel's full (non-truncated) short_description
      // stands in as the "why it's here" editorial line.
      <ol class="mt-10 divide-y divide-brand-divider dark:divide-brand-divider-dark">
        {rankedEntities.map((entity, i) => {
          const brand = brandPresentation(entity);
          const reg = brand ? TIER_REGISTER[brand.tier] : null;
          const displayName = brand ? brand.displayName : entity.name;
          const monogram = brand ? brand.monogram : (entity.name ?? '?').trim().charAt(0).toUpperCase();
          const guestScore = entity.sentiment_scores?.overall ?? null;
          const metaLine = [brand && `${brand.label} · ${tierLabel(brand.tier)}`, entity.core_facts?.neighborhood]
            .filter(Boolean)
            .join(' · ');
          return (
            <li class="flex gap-4 py-6 first:pt-0">
              <span
                class="mt-1 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-brand-primary text-sm font-bold text-brand-primary-ink dark:text-brand-primary-ink-dark"
                aria-hidden="true"
              >
                {i + 1}
              </span>
              <div class="min-w-0 flex-1">
                <div class="flex items-start gap-3">
                  <span
                    class={`flex h-10 w-10 flex-none items-center justify-center rounded-md font-serif text-base ${brand ? reg.panel : 'bg-brand-panel-a text-brand-text/70 dark:bg-brand-panel-a-dark dark:text-brand-text-dark/70'}`}
                    aria-hidden="true"
                  >
                    {monogram}
                  </span>
                  <div class="min-w-0 flex-1">
                    <a
                      href={urls.entity(entity.slug)}
                      class="font-serif text-lg leading-snug hover:text-brand-primary dark:hover:text-brand-primary-hover-dark"
                    >
                      {displayName}
                    </a>
                    {metaLine && <p class="kicker mt-0.5 text-brand-faint dark:text-brand-faint-dark">{metaLine}</p>}
                  </div>
                  {
                    // Always reserve this column, even when unscored --
                    // a handful of very recent openings (e.g. Andaz One
                    // Bangkok) haven't been through guest-sentiment
                    // research yet. Hiding the slot for just those rows
                    // made the list look broken rather than honest, so an
                    // unscored hotel gets a plain placeholder instead of
                    // either a fabricated number or a missing column.
                  }
                  <div class="flex-none text-center">
                    <div class="font-serif text-xl leading-none tabular-nums text-brand-text dark:text-brand-text-dark">
                      {guestScore != null ? guestScore : '—'}
                    </div>
                    <p class="kicker mt-0.5 text-brand-faint dark:text-brand-faint-dark">
                      {guestScore != null ? 'Score' : 'Not yet scored'}
                    </p>
                  </div>
                </div>
                {entity.short_description && (
                  <p class="mt-3 text-sm leading-relaxed text-brand-muted dark:text-brand-muted-dark">{entity.short_description}</p>
                )}
                <a href={urls.entity(entity.slug)} class="mt-2 inline-block text-sm font-bold link-accent">
                  Full review &rarr;
                </a>
              </div>
            </li>
          );
        })}
      </ol>
    ) : (
      <p class="mt-10 text-brand-muted dark:text-brand-muted-dark">
        No {siteConfig.entityLabelPlural} currently match this guide's criteria -- check back soon.
      </p>
    )}

    <section class="mt-14">
      <FAQSection faqs={listicle.faqs} />
    </section>
  </div>
</BaseLayout>
