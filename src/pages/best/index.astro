---
import siteConfig from '../../lib/config.js';
import { urls } from '../../lib/urls.js';
import { loadListicles, loadEntities, loadCategories, loadRegions, stripMeta, isPublished } from '../../lib/data.js';
import { resolveListicleMatchesUnlimited, fillListicleCounts } from '../../lib/listicles.js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import HubCard from '../../components/HubCard.astro';
import { buildBreadcrumbListSchema } from '../../lib/schema-jsonld.js';

// Same {{count}} substitution as the guide pages themselves -- this index
// renders each guide's intro, so without it a raw placeholder would show
// here even though the guide's own page reads correctly.
const allEntities = loadEntities().map(stripMeta).filter(isPublished);
const allCategories = loadCategories().map(stripMeta);
const allRegions = loadRegions().map(stripMeta);
const listicles = loadListicles()
  .map(stripMeta)
  .filter(isPublished)
  .map((listicle) => ({
    ...listicle,
    intro: fillListicleCounts(
      listicle.intro,
      resolveListicleMatchesUnlimited(listicle, allEntities, allRegions, allCategories).length
    ),
  }));

const breadcrumbItems = [
  { label: siteConfig.siteName, href: urls.home() },
  { label: 'Recommends', href: urls.listiclesIndex() },
];

const jsonLd = [buildBreadcrumbListSchema(breadcrumbItems, Astro.site)].filter(Boolean);
---

<BaseLayout
  title="Recommends"
  description={`Curated, filter-driven guides to the best ${siteConfig.entityLabelPlural} on ${siteConfig.siteName}.`}
  canonicalPath={urls.listiclesIndex()}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <Breadcrumb items={breadcrumbItems} />
    <h1 class="mt-4 font-serif text-3xl font-semibold sm:text-4xl">Recommends</h1>
    <p class="mt-3 max-w-2xl text-brand-muted dark:text-brand-muted-dark">
      Curated shortlists built from verified {siteConfig.entityLabelPlural}, filtered and ranked by structured criteria
      rather than written from scratch.
    </p>

    {listicles.length > 0 ? (
      <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {listicles.map((listicle) => (
          <HubCard href={urls.listicle(listicle.slug)} label={listicle.title} description={listicle.intro} />
        ))}
      </div>
    ) : (
      <p class="mt-8 text-brand-muted dark:text-brand-muted-dark">No guides published yet.</p>
    )}
  </div>
</BaseLayout>
