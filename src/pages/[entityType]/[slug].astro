---
// This route's own folder name, "[entityType]", is a dynamic Astro route
// param, not a literal word -- getStaticPaths below is the ONLY place that
// decides its actual value, and it always uses
// site.config.json.entityLabelPlural (e.g. "races", "hotels"). This is how
// entity URLs like /races/some-slug/ exist without this file (or any other
// shared file) ever containing the literal word "race".
import siteConfig from '../../lib/config.js';
import { urls, entityUrlSegment } from '../../lib/urls.js';
import { loadEntities, loadCategories, loadRegions, loadListicles, stripMeta, isPublished } from '../../lib/data.js';
import { resolveListicleEntities } from '../../lib/listicles.js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FactsTable from '../../components/FactsTable.astro';
import EliteBenefits from '../../components/EliteBenefits.astro';
import ProsCons from '../../components/ProsCons.astro';
import SentimentBreakdown from '../../components/SentimentBreakdown.astro';
import ResearchNotes from '../../components/ResearchNotes.astro';
import ExternalCoverage from '../../components/ExternalCoverage.astro';
import SourceMix from '../../components/SourceMix.astro';
import FAQSection from '../../components/FAQSection.astro';
import CTABlock from '../../components/CTABlock.astro';
import RelatedEntities from '../../components/RelatedEntities.astro';
import RelatedListicles from '../../components/RelatedListicles.astro';
import LastUpdated from '../../components/LastUpdated.astro';
import Pill from '../../components/Pill.astro';
import { narrowFactsToCategories } from '../../lib/categoryMatch.js';
import { brandPresentation, tierLabel, TIER_REGISTER } from '../../lib/brand.js';
import { participatesInProgram, nonParticipationBadge } from '../../lib/loyalty.js';
import { buildEntitySchema, buildFaqPageSchema, buildBreadcrumbListSchema } from '../../lib/schema-jsonld.js';

export function getStaticPaths() {
  // Same publish rule as every hub and the sitemap: a detail page exists
  // for exactly the records that are linked to, so nothing is orphaned and
  // a retired record doesn't leave a stale page behind.
  const entities = loadEntities().map(stripMeta).filter(isPublished);
  return entities.map((entity) => ({
    params: { entityType: entityUrlSegment, slug: entity.slug },
    props: { entity },
  }));
}

const { entity } = Astro.props;
const categories = loadCategories().map(stripMeta);
const regions = loadRegions().map(stripMeta);
const allEntities = loadEntities().map(stripMeta).filter(isPublished);

const category = categories.find((c) => c.category_id === entity.category_id);
const region = regions.find((r) => r.region_id === entity.region_id);

// Image-free hero: a hotel (any entity with a Bonvoy sub-brand) gets a
// tier-coded "verdict band" where the photo used to be -- brand, tier and
// the reliability score. Deliberately does not restate the granular facts,
// which FactsTable already renders below.
const brand = brandPresentation(entity);
const reg = brand ? TIER_REGISTER[brand.tier] : null;

// The headline metric is now the research-derived guest sentiment score
// (sentiment_scores.overall), not reliability_score -- reliability is an
// internal data-freshness signal and no longer shown to readers. Falls back
// to null so a not-yet-scored entity simply shows no number rather than a
// misleading one.
const guestScore = entity.sentiment_scores?.overall ?? null;

// The single most important fact about a hotel on a loyalty-program site
// is whether the program actually applies here -- and for a handful of
// properties it doesn't, despite the chain's name over the door. That can't
// be left to a sentence in the facts table halfway down the page: it gets a
// banner directly under the masthead, and the raw field is dropped from the
// facts table below so the same fact isn't stated twice in two registers.
const participates = participatesInProgram(entity);

// The elite fields get their own section below (EliteBenefits) rather than
// rows in the generic facts table, and loyalty_participation is carried by
// the banner above -- so all four come out of what FactsTable renders. The
// rest of core_facts (address, brand, neighborhood, distances) is exactly
// what a key/value table is good at.
const {
  loyalty_participation: _participationFact,
  elite_benefits: _eliteBenefits,
  elite_notes: _eliteNotes,
  breakfast: _breakfast,
  lounge: _lounge,
  points_value_notes: _pointsValueNotes,
  ...displayFacts
} = entity.core_facts ?? {};

const relatedEntities = allEntities.filter(
  (e) => entity.related_entity_ids?.includes(e.entity_id) && e.entity_id !== entity.entity_id
);

// A guide is "related" if THIS entity satisfies the guide's own filters --
// tested by running the guide's resolver against a one-element list, so the
// membership rule here can never drift from what /best/<slug>/ actually
// lists. That reuse also gets region-ancestry, tag and core_facts filters,
// the marquee-or-range category rule, and manual_entity_ids pins for free.
//
// The pre-removal version of this matched on `filters.category_id` alone,
// which was survivable in the races instance (guides were category-wide)
// but is wrong here: every guide is category x country, so a Bangkok
// Marriott would have linked to "Best Marriott Bonvoy hotels in Singapore"
// purely because both carry category_id "marriott-bonvoy".
//
// Note the guide's `limit` doesn't gate this -- a hotel ranked below a
// guide's top 15 still gets the link, which is correct for a heading that
// reads "Related guides" (the guide does cover its program and country)
// and is the point of the block: it's what gives each guide inbound
// internal links from every hotel it covers.
const relatedListicles = siteConfig.enabledFeatures?.listicles
  ? loadListicles()
      .map(stripMeta)
      .filter(isPublished)
      .filter((l) => resolveListicleEntities(l, [entity], regions, categories).length > 0)
  : [];

const breadcrumbItems = [
  { label: siteConfig.siteName, href: urls.home() },
  ...(region ? [{ label: region.label, href: urls.region(region.slug) }] : []),
  { label: entity.name, href: urls.entity(entity.slug) },
];

const canonicalUrl = new URL(urls.entity(entity.slug), Astro.site).toString();

// Built from the exact same `entity` / `breadcrumbItems` data already on
// this page -- nothing gets defined twice for display vs. schema. Each
// piece is gated by its own enabledFeatures flag so a vertical instance
// can turn schema types on/off without touching this file.
const jsonLd = [
  buildEntitySchema(entity, siteConfig, canonicalUrl),
  ...(siteConfig.enabledFeatures?.faqSchema ? [buildFaqPageSchema(entity.faqs)] : []),
  buildBreadcrumbListSchema(breadcrumbItems, Astro.site),
].filter(Boolean);
---

<BaseLayout
  title={entity.name}
  description={entity.short_description}
  canonicalPath={urls.entity(entity.slug)}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <Breadcrumb items={breadcrumbItems} />

    {brand ? (
      <div class="mt-4">
        {/* Image-free masthead: the tinted tier register IS the hero. Adopts
            the hotel's tier colour (black-tie for luxury, gold for premium,
            pale for select), carries the name + guest sentiment score, and the
            short description sits in the surface strip below. */}
        <div class={`relative overflow-hidden rounded-t-xl p-6 sm:p-8 ${reg.panel}`}>
          {reg.tex && <span class="tier-tex" aria-hidden="true"></span>}
          <p class={`kicker relative z-10 ${reg.label}`}>{brand.label} &middot; {tierLabel(brand.tier)}</p>
          <div class="relative z-10 mt-2 flex items-end justify-between gap-5">
            <div class="min-w-0">
              <h1 class="font-serif text-3xl font-normal leading-tight sm:text-4xl">{entity.name}</h1>
              {entity.core_facts?.neighborhood && (
                <p class="mt-2 text-sm opacity-90">{entity.core_facts.neighborhood}</p>
              )}
            </div>
            {guestScore != null && (
              <div class="flex-none text-center">
                <div class="font-serif text-4xl leading-none tabular-nums sm:text-5xl">{guestScore}</div>
                <p class="kicker mt-1 opacity-80">Guest sentiment</p>
              </div>
            )}
          </div>
        </div>
        <p class="rounded-b-xl border border-t-0 border-brand-divider bg-brand-surface px-6 py-4 text-brand-muted dark:border-brand-divider-dark dark:bg-brand-surface-dark sm:px-8">
          {entity.short_description}
        </p>
        {!participates && (
          <div
            class="mt-4 rounded-lg bg-brand-warning-highlight px-5 py-4 text-sm leading-relaxed text-brand-warning dark:bg-brand-warning-highlight-dark dark:text-brand-warning-dark"
            role="note"
          >
            <p class="kicker">{nonParticipationBadge(category)}</p>
            <p class="mt-1.5">
              This property carries the {brand.label} name but is not enrolled in
              {category ? ` ${category.label}` : ' its chain\'s loyalty program'}. A stay here earns no points and
              confers no elite benefits, so it is left out of this site's program counts, editor's picks and ranked
              guides. Everything below still applies -- it is simply not a loyalty stay.
            </p>
          </div>
        )}
      </div>
    ) : (
      <Fragment>
        <h1 class="mt-4 font-serif text-3xl font-semibold sm:text-4xl">{entity.name}</h1>
        <p class="mt-3 text-lg text-brand-muted dark:text-brand-muted-dark">{entity.short_description}</p>
      </Fragment>
    )}
    <div class="mt-3">
      <LastUpdated date={entity.last_updated} />
    </div>

    <div class="prose-content mt-8">
      <p>{entity.ai_summary}</p>
    </div>

    {entity.sentiment_scores?.breakdown?.length > 0 && (
      <section class="mt-8">
        {/* The headline overall sits in the masthead; this section shows the
            per-category guest-score breakdown (showOverall={false}). */}
        <h2 class="mb-4 text-xl font-semibold">How guests rate it</h2>
        <SentimentBreakdown sentiment={entity.sentiment_scores} showOverall={false} />
      </section>
    )}

    <div class="mt-8">
      <FactsTable facts={narrowFactsToCategories(displayFacts, categories)} />
    </div>

    <div class="mt-10">
      <EliteBenefits entity={entity} category={category} />
    </div>

    <div class="mt-8">
      <ProsCons pros={entity.pros} cons={entity.cons} />
    </div>

    {(entity.research_highlights?.length > 0 || entity.research_watchouts?.length > 0) && (
      <div class="mt-10">
        <ResearchNotes
          highlights={entity.research_highlights}
          watchouts={entity.research_watchouts}
          confidence={entity.research_confidence}
        />
      </div>
    )}

    {entity.external_coverage && (
      <div class="mt-10">
        <ExternalCoverage reviews={entity.external_coverage.reviews} videos={entity.external_coverage.videos} />
      </div>
    )}

    {entity.source_mix?.length > 0 && (
      <div class="mt-10">
        <SourceMix sources={entity.source_mix} lastUpdated={entity.research_last_updated} />
      </div>
    )}

    {entity.tags?.length > 0 && (
      <div class="mt-8 flex flex-wrap gap-1.5">
        {entity.tags.map((tag) => <Pill>{tag}</Pill>)}
      </div>
    )}

    <div class="mt-8">
      <CTABlock
        ctaLinks={entity.cta_links}
        affiliateLinks={entity.affiliate_links}
        heading={`Find out more about ${entity.name}`}
      />
    </div>

    <div class="mt-10">
      <FAQSection faqs={entity.faqs} />
    </div>

    <div class="mt-10">
      <RelatedEntities entities={relatedEntities} categories={categories} heading={`Related ${siteConfig.entityLabelPlural}`} />
    </div>

    <div class="mt-10">
      <RelatedListicles listicles={relatedListicles} />
    </div>

    <div class="mt-10 flex flex-wrap gap-4 text-sm">
      {category && (
        <a href={urls.category(category.slug)} class="link-accent">
          More {category.label} {siteConfig.entityLabelPlural} →
        </a>
      )}
      {region && (
        <a href={urls.region(region.slug)} class="link-accent">
          More {siteConfig.entityLabelPlural} in {region.label} →
        </a>
      )}
    </div>
  </div>
</BaseLayout>
